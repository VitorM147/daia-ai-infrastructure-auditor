# Relatórios do DAIA são gerados sob demanda e não são versionados
daia/reports/*
!daia/reports/.gitkeep

# Saída gerada pelo script de evals
daia/evals/last-run.md

# Dados operacionais internos: não publicar no repositório
# Inclui inventário, ownership, hosts, fingerprints e histórico de auditorias
daia/knowledge/*
!daia/knowledge/.gitkeep
daia/audit-log.md
daia/findings/registry.md

# Artefatos Python
__pycache__/
*.py[cod]

daia/evals/behavioral-last-run.json
# Saídas locais avulsas do executor comportamental (use --record para histórico versionado)
daia/evals/*.result.json

# Checkpoints e cache de auditorias orquestradas (dados operacionais)
daia/audits/
daia/findings/registry.json
